---
import { FORMAT_LABELS } from '@pub/site-kit';
import { siteConfig } from '../site.config.js';

const {
  title,
  description,
  date,
  format = 'essay',
  author = siteConfig.author,
  minutes,
} = Astro.props;
const label = FORMAT_LABELS[format] || 'Essay';
const dateLabel = date instanceof Date
  ? date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })
  : date;
---
<span class="kicker">{label}</span>
<h1>{title}</h1>
{description && <p class="dek">{description}</p>}
<p class="byline">
  <a href="/author/">{author}</a>
  · {dateLabel}
  {minutes != null && <span class="read-time"> · {minutes} min read</span>}
</p>

<style>
  .dek { font-style: italic; font-size: 19px; color: var(--body2); }
  .byline { font-family: var(--font-mono); font-size: 11px; letter-spacing: .16em; text-transform: uppercase; color: var(--muted); margin-top: 1rem; }
  .byline a { color: inherit; border-bottom: none; }
  .byline a:hover { color: var(--accent); }
  .read-time { letter-spacing: .1em; }
</style>
