---
const { src, alt = '', priority = false } = Astro.props;
---
{src && (
  <img
    class="essay-hero"
    src={src}
    alt={alt}
    decoding="async"
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : undefined}
    width="1600"
    height="900"
  />
)}

<style>
  .essay-hero { margin: 2rem 0; width: 100%; height: auto; }
  @media print {
    .essay-hero { max-height: 3.5in; object-fit: cover; }
  }
</style>
