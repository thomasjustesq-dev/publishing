---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { fetchSubstackPosts } from '../lib/substack.js';
import { siteConfig } from '../site.config.js';
import { essayFilter } from '../lib/essays.js';
import { FORMAT_LABELS, websiteJsonLd, personJsonLd } from '@pub/site-kit';

const essays = (await getCollection('essays', essayFilter))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const substackPosts = await fetchSubstackPosts();
const site = Astro.site || new URL(import.meta.env.PUBLIC_SITE_URL || siteConfig.siteUrl);
const jsonLd = [
  websiteJsonLd({
    name: siteConfig.name,
    url: site.toString(),
    description: siteConfig.description,
    author: siteConfig.author,
  }),
  personJsonLd({
    name: siteConfig.author,
    url: new URL('/about/', site).toString(),
    jobTitle: 'Trial attorney',
    sameAs: [siteConfig.substackUrl],
  }),
];
---
<Base title={siteConfig.name} description={siteConfig.description} jsonLd={jsonLd}>
  <span class="kicker">Docket</span>
  <h1>{siteConfig.name}</h1>
  <p class="dek">Essays on what happens where AI, national security, and civil liberties collide.</p>

  <hr />

  <section>
    {essays.length === 0 && (
      <div class="empty-docket">
        <p class="mission">Writing from the edge of AI, security, and liberty — filed here in designed form, distributed by email on Substack.</p>
        <p>Nothing filed yet.</p>
        <p class="empty-note">
          The first docket entries will appear here as essays publish.
          <a href={siteConfig.subscribeUrl} target="_blank" rel="noopener">Subscribe on Substack</a>
          for the opening brief.
        </p>
      </div>
    )}
    <ul class="docket-list">
      {essays.map((e, i) => {
        const format = e.data.format || 'essay';
        const label = format !== 'essay' ? FORMAT_LABELS[format] : null;
        return (
          <li class="docket-row">
            <span class="docket-no">№ {String(essays.length - i).padStart(3, '0')}</span>
            <span class="docket-main">
              {label && <span class="format-badge">{label}</span>}
              <a href={`/essays/${e.id}/`}>{e.data.title}</a>
            </span>
            <span class="docket-date">{e.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
          </li>
        );
      })}
    </ul>
  </section>

  {substackPosts.length > 0 && (
    <section>
      <span class="kicker">From the Substack</span>
      <ul class="docket-list">
        {substackPosts.slice(0, 5).map((p) => (
          <li class="docket-row"><a href={p.link}>{p.title}</a></li>
        ))}
      </ul>
    </section>
  )}
</Base>

<style>
  .dek { font-style: italic; font-size: 19px; color: var(--body2); max-width: 44ch; }
  .empty-docket { padding: 1rem 0 2rem; max-width: 44ch; }
  .mission { font-family: var(--font-display); font-style: italic; font-size: 22px; color: var(--ink); line-height: 1.35; }
  .empty-note { color: var(--muted); font-size: 16px; }
  .docket-list { list-style: none; padding: 0; margin: 0; }
  .docket-row {
    display: flex; align-items: baseline; gap: 1rem; padding: 1rem 0;
    border-bottom: 1px solid var(--line);
  }
  .docket-no { font-family: var(--font-mono); font-size: 11px; color: var(--muted); letter-spacing: .1em; width: 4rem; flex-shrink: 0; }
  .docket-main { flex: 1; min-width: 0; }
  .docket-row a { color: var(--ink); text-decoration: none; font-family: var(--font-display); font-size: 22px; }
  .docket-row a:hover { color: var(--accent); }
  .docket-date { margin-left: auto; font-family: var(--font-mono); font-size: 11px; color: var(--muted); }
  .format-badge {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--accent);
    margin-right: 0.5rem;
  }
</style>
