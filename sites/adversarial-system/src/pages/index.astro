---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { fetchSubstackPosts } from '../lib/substack.js';
import { siteConfig } from '../site.config.js';

const essays = (await getCollection('essays', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const substackPosts = await fetchSubstackPosts();
---
<Base title={siteConfig.name} description={siteConfig.description}>
  <span class="kicker">Docket</span>
  <h1>{siteConfig.name}</h1>
  <p class="dek">Essays on what happens where AI, national security, and civil liberties collide.</p>

  <hr />

  <section>
    {essays.length === 0 && <p>No essays filed yet.</p>}
    <ul class="docket-list">
      {essays.map((e, i) => (
        <li class="docket-row">
          <span class="docket-no">№ {String(essays.length - i).padStart(3, '0')}</span>
          <a href={`/essays/${e.id}/`}>{e.data.title}</a>
          <span class="docket-date">{e.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
        </li>
      ))}
    </ul>
  </section>

  {substackPosts.length > 0 && (
    <section>
      <span class="kicker">From the Substack</span>
      <ul class="docket-list">
        {substackPosts.slice(0, 5).map((p) => (
          <li class="docket-row"><a href={p.link}>{p.title}</a></li>
        ))}
      </ul>
    </section>
  )}
</Base>

<style>
  .dek { font-style: italic; font-size: 19px; color: var(--body2); max-width: 44ch; }
  .docket-list { list-style: none; padding: 0; margin: 0; }
  .docket-row {
    display: flex; align-items: baseline; gap: 1rem; padding: 1rem 0;
    border-bottom: 1px solid var(--line);
  }
  .docket-no { font-family: var(--font-mono); font-size: 11px; color: var(--muted); letter-spacing: .1em; width: 4rem; flex-shrink: 0; }
  .docket-row a { color: var(--ink); text-decoration: none; font-family: var(--font-display); font-size: 22px; }
  .docket-row a:hover { color: var(--accent); }
  .docket-date { margin-left: auto; font-family: var(--font-mono); font-size: 11px; color: var(--muted); }
</style>
