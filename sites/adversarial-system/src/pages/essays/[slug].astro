---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const essays = await getCollection('essays', ({ data }) => !data.draft);
  return essays.map((essay) => ({ params: { slug: essay.id }, props: { essay } }));
}

const { essay } = Astro.props;
const { Content } = await render(essay);
const site = Astro.site || new URL(import.meta.env.PUBLIC_SITE_URL || 'https://theadversarialsystem.com');
const essayUrl = new URL(`/essays/${essay.id}/`, site).toString();
const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: essay.data.title,
  description: essay.data.description,
  datePublished: essay.data.date.toISOString(),
  dateModified: (essay.data.updated || essay.data.date).toISOString(),
  author: { '@type': 'Person', name: 'Thomas M. Just' },
  mainEntityOfPage: essayUrl,
  image: essay.data.hero ? new URL(essay.data.hero, site).toString() : undefined,
};
---
<Base
  title={essay.data.title}
  description={essay.data.description}
  ogImage={essay.data.hero || '/social/og-card-1200x630.png'}
  type="article"
  publishedTime={essay.data.date.toISOString()}
  modifiedTime={(essay.data.updated || essay.data.date).toISOString()}
  jsonLd={articleJsonLd}
>
  <article class="essay">
    <span class="kicker">Essay</span>
    <h1>{essay.data.title}</h1>
    {essay.data.description && <p class="dek">{essay.data.description}</p>}
    <p class="byline">Thomas M. Just · {essay.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</p>

    {essay.data.hero && <img class="cover-plate" src={essay.data.hero} alt="" decoding="async" />}

    <div class="essay-body">
      <Content />
    </div>

    {essay.data.substackUrl && (
      <p class="discuss"><a href={essay.data.substackUrl}>Discuss this essay on Substack →</a></p>
    )}
  </article>
</Base>

<style>
  .dek { font-style: italic; font-size: 19px; color: var(--body2); max-width: 44ch; }
  .byline { font-family: var(--font-mono); font-size: 11px; text-transform: uppercase; letter-spacing: .14em; color: var(--muted); margin-top: 1rem; }
  .cover-plate { border: 1px solid var(--line); margin: 2rem 0; }
  .essay-body { font-size: 18px; line-height: 1.75; }
  .essay-body > p:first-of-type::first-letter {
    float: left; font-family: var(--font-display); font-size: 52px; line-height: .72;
    color: var(--accent); padding: 8px 9px 0 0;
  }
  .discuss { margin-top: 3rem; font-family: var(--font-mono); font-size: 12px; text-transform: uppercase; letter-spacing: .1em; }
</style>
