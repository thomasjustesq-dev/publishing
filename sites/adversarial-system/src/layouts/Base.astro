---
// Base shell for every page. Replace/extend this with the Claude-designed layout —
// keep all colors/fonts coming from tokens.css so the brand kit stays authoritative.
import '../styles/tokens.css';
const { title = 'The Adversarial System', description = '' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {import.meta.env.PROD && <script is:inline defer src="/_vercel/insights/script.js"></script>}
  </head>
  <body>
    <header class="masthead">
      <a href="/" class="wordmark">The Adversarial System</a>
    </header>
    <main>
      <slot />
    </main>
    <footer class="colophon">
      <p>&copy; The Adversarial System · <a href="https://theadversarialsystem.substack.com">Subscribe on Substack</a></p>
    </footer>
  </body>
</html>

<style is:global>
  body {
    margin: 0;
    background: var(--color-background);
    color: var(--color-ink);
    font-family: var(--font-body);
    font-size: var(--size-base);
    line-height: 1.65;
  }
  main { max-width: var(--measure); margin: 0 auto; padding: 2rem 1.25rem 4rem; }
  a { color: var(--color-accent); }
  h1, h2, h3 { font-family: var(--font-display); line-height: 1.2; }
  h1 { font-size: var(--size-h1); }
  h2 { font-size: var(--size-h2); }
  h3 { font-size: var(--size-h3); }
  img { max-width: 100%; height: auto; }
  blockquote {
    margin: 1.5rem 0; padding: 0.25rem 1.25rem;
    border-left: 3px solid var(--color-accent);
    background: var(--color-accent-soft); color: var(--color-ink);
  }
  hr { border: 0; border-top: 1px solid var(--color-rule); margin: 2.5rem auto; width: 40%; }
  .masthead { padding: 1.5rem 1.25rem; border-bottom: 1px solid var(--color-rule); text-align: center; }
  .wordmark { font-family: var(--font-display); font-size: 1.4rem; text-decoration: none; color: var(--color-ink); }
  .colophon { border-top: 1px solid var(--color-rule); padding: 1.5rem; text-align: center; font-family: var(--font-ui); font-size: 0.85rem; color: var(--color-ink-muted); }
</style>
