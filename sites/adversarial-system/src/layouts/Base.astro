---
// Base shell — Adversarial System brand kit (masthead, volume bar, double-rule motif).
import '../styles/fonts.css';
import '../styles/tokens.css';
import { serializeJsonLd } from '@pub/core';
import { siteConfig } from '../site.config.js';
import DraftBanner from '../components/DraftBanner.astro';

const {
  title = siteConfig.name,
  description = '',
  ogImage = siteConfig.defaultOgImage,
  type = 'website',
  publishedTime = null,
  modifiedTime = null,
  jsonLd = null,
  preloadImage = null,
} = Astro.props;
const site = Astro.site || new URL(import.meta.env.PUBLIC_SITE_URL || siteConfig.siteUrl);
const canonical = new URL(Astro.url.pathname, site).toString();
const absoluteOgImage = ogImage ? new URL(ogImage, site).toString() : null;
const rssUrl = new URL('/rss.xml', site).toString();
const jsonLdBlocks = jsonLd == null ? [] : Array.isArray(jsonLd) ? jsonLd : [jsonLd];
---
<!doctype html>
<html lang="en" data-theme-storage-key={siteConfig.themeStorageKey}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={`${siteConfig.name} RSS`} href={rssUrl} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={type} />
    {absoluteOgImage && <meta property="og:image" content={absoluteOgImage} />}
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    <meta name="twitter:card" content="summary_large_image" />
    {absoluteOgImage && <meta name="twitter:image" content={absoluteOgImage} />}
    {jsonLdBlocks.map((block) => (
      <script type="application/ld+json" set:html={serializeJsonLd(block)} />
    ))}
    <link rel="icon" href={siteConfig.favicon} type="image/svg+xml" />
    <script is:inline src="/theme-init.js"></script>
    {import.meta.env.PROD && <script is:inline defer src="/_vercel/insights/script.js"></script>}
    {preloadImage && <link rel="preload" as="image" href={preloadImage} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <DraftBanner />
    <div class="volume-bar">
      <span>Vol. I — Austin</span>
      <span class="vb-date">{new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
      <span>Independent</span>
    </div>

    <header class="masthead">
      <a href="/" class="wordmark-link">
        <img src="/brand/wordmark-primary.png" alt={siteConfig.name} class="wordmark-img" width="960" height="400" decoding="async" />
      </a>
      <nav class="nav" aria-label="Primary">
        <a href="/">Docket</a>
        <a href="/tags/">Tags</a>
        <a href="/search/">Search</a>
        <a href="/author/">Author</a>
        <a href="/about/">About</a>
        <a href="/standards/">Standards</a>
        <button id="theme-toggle" class="theme-toggle" aria-label="Toggle theme" aria-pressed="false" type="button">☾</button>
        <a class="subscribe-btn" href={siteConfig.subscribeUrl} target="_blank" rel="noopener">Subscribe</a>
      </nav>
    </header>

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <footer class="colophon">
      <div class="rule-double"></div>
      <p class="tagline">{siteConfig.tagline}</p>
      <p class="copyright">&copy; {new Date().getFullYear()} {siteConfig.author} · <a href={siteConfig.substackUrl}>Subscribe on Substack</a></p>
    </footer>

    <script is:inline src="/theme-toggle.js"></script>
  </body>
</html>

<style is:global>
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--paper);
    color: var(--body);
    font-family: var(--font-body);
    font-size: 17px;
    line-height: 1.65;
    transition: background .2s, color .2s;
  }
  main { max-width: var(--measure); margin: 0 auto; padding: 2.5rem var(--gutter-desktop) 5rem; }
  a { color: var(--accent); }
  h1, h2, h3 { font-family: var(--font-display); font-weight: 400; line-height: 1; letter-spacing: -.01em; color: var(--ink); }
  h1 { font-size: clamp(44px, 6vw, 64px); line-height: 1.08; }
  h2 { font-size: 30px; }
  h3 { font-size: 22px; }
  img { max-width: 100%; height: auto; }

  blockquote {
    margin: 1.75rem 0; padding-left: 24px;
    border-left: 2px solid var(--accent);
    font-family: var(--font-display); font-style: italic;
    font-size: 24px; line-height: 1.42; color: var(--ink);
  }
  hr { border: 0; margin: 3rem 0; }
  hr::before {
    content: ''; display: block; border-top: 2.5px solid var(--ink); margin-bottom: 4px;
  }
  hr::after {
    content: ''; display: block; border-top: 1.5px solid var(--ink);
  }
  pre { background: var(--panel); border: 1px solid var(--line); padding: 1rem; overflow-x: auto; font-family: var(--font-mono); font-size: 14px; }
  code { font-family: var(--font-mono); }

  .kicker {
    font-family: var(--font-mono); text-transform: uppercase; letter-spacing: .24em;
    font-size: 11px; color: var(--accent); display: block; margin-bottom: .6rem;
  }

  .volume-bar {
    font-family: var(--font-mono); text-transform: uppercase; letter-spacing: .18em;
    font-size: 10.5px; color: var(--muted); display: flex; justify-content: space-between;
    padding: 8px var(--gutter-desktop); border-bottom: 1px solid var(--ink);
  }
  @media (max-width: 900px) { .volume-bar { display: none; } }

  .masthead {
    display: flex; align-items: center; justify-content: space-between;
    padding: 1.25rem var(--gutter-desktop); border-bottom: 1px solid var(--line);
    background: var(--paper-glass); backdrop-filter: blur(6px);
    position: sticky; top: 0; z-index: 10;
  }
  .wordmark-link { display: block; line-height: 0; }
  .wordmark-img { height: 28px; width: auto; }
  html[data-theme='dark'] .wordmark-img { filter: invert(1) brightness(1.6); }
  .nav { display: flex; align-items: center; gap: 1.5rem; font-family: var(--font-mono); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; }
  .nav a { color: var(--ink); text-decoration: none; }
  .skip-link {
    position: absolute; left: -9999px; top: 0; z-index: 1000;
    background: var(--accent); color: var(--paper); padding: 0.5rem 1rem;
    font-family: var(--font-mono); font-size: 12px; text-transform: uppercase;
  }
  .skip-link:focus { left: 0.5rem; top: 0.5rem; }
  .theme-toggle:focus-visible, .nav a:focus-visible, .subscribe-btn:focus-visible {
    outline: 2px solid var(--accent); outline-offset: 2px;
  }
  @media print {
    .masthead, .colophon, .volume-bar, .draft-banner, .skip-link, .theme-toggle, .subscribe-btn { display: none !important; }
  }
  .theme-toggle {
    font-family: var(--font-mono); border: 1px solid var(--line); background: transparent;
    color: var(--ink); width: 30px; height: 30px; cursor: pointer; border-radius: 0;
  }
  .subscribe-btn {
    background: var(--accent); color: var(--paper) !important; padding: 8px 16px;
    border: 1px solid var(--accent);
  }
  .subscribe-btn:hover { background: transparent; color: var(--accent) !important; }

  .rule-double { border-top: 2.5px solid var(--ink); margin-bottom: 4px; }
  .rule-double::after { content: ''; display: block; border-top: 1.5px solid var(--ink); margin-top: 4px; }
  .colophon {
    padding: 2rem var(--gutter-desktop) 3rem; text-align: center;
    font-family: var(--font-mono); font-size: 11px; letter-spacing: .1em; color: var(--muted);
  }
  .colophon .tagline { font-family: var(--font-display); font-style: italic; font-size: 18px; color: var(--body2); letter-spacing: 0; margin: 1rem 0; text-transform: none; }
  .colophon a { color: var(--muted); }
</style>
