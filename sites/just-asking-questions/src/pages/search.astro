---
import Base from '../layouts/Base.astro';
import { siteConfig } from '../site.config.js';
---
<Base title={`Search · ${siteConfig.name}`} description="Search essays.">
  <span class="kicker">Search</span>
  <h1>Search</h1>
  <div id="search" class="search-ui"></div>
  <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
  <script is:inline src="/pagefind/pagefind-ui.js"></script>
  <script is:inline>
    window.addEventListener('DOMContentLoaded', function () {
      if (typeof PagefindUI === 'undefined') {
        document.getElementById('search').textContent = 'Search index builds on production deploy. Run npm run build locally to generate it.';
        return;
      }
      new PagefindUI({ element: '#search', showSubResults: true, showImages: false });
    });
  </script>
</Base>

<style>
  .search-ui { margin-top: 1.5rem; min-height: 8rem; }
  :global(.pagefind-ui) { --pagefind-ui-font: var(--font-body); --pagefind-ui-primary: var(--accent); --pagefind-ui-text: var(--ink); --pagefind-ui-background: var(--background); --pagefind-ui-border: var(--hairline-strong); }
</style>
