---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { fetchSubstackPosts } from '../lib/substack.js';
import { siteConfig } from '../site.config.js';
import { essayFilter } from '../lib/essays.js';
import { FORMAT_LABELS, websiteJsonLd, personJsonLd } from '@pub/site-kit';

const essays = (await getCollection('essays', essayFilter))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const substackPosts = await fetchSubstackPosts();
const site = Astro.site || new URL(import.meta.env.PUBLIC_SITE_URL || siteConfig.siteUrl);
const jsonLd = [
  websiteJsonLd({
    name: siteConfig.name,
    url: site.toString(),
    description: siteConfig.description,
    author: siteConfig.author,
  }),
  personJsonLd({
    name: siteConfig.author,
    url: new URL('/about/', site).toString(),
    jobTitle: 'Trial attorney',
    sameAs: [siteConfig.substackUrl],
  }),
];
---
<Base title={siteConfig.name} description={siteConfig.description} jsonLd={jsonLd}>
  <h1>{siteConfig.name}</h1>
  <p class="dek">Essays by {siteConfig.author} — trial attorney, USAF veteran.</p>

  <hr />

  <section>
    {essays.length === 0 && <p>No essays yet.</p>}
    <ul class="essay-list">
      {essays.map((e) => {
        const format = e.data.format || 'essay';
        const label = format !== 'essay' ? FORMAT_LABELS[format] : null;
        return (
          <li>
            {label && <span class="format-badge">{label}</span>}
            <a href={`/essays/${e.id}/`}>{e.data.title}</a>
            <small class="date"> — {e.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</small>
          </li>
        );
      })}
    </ul>
  </section>

  {substackPosts.length > 0 && (
    <section>
      <span class="kicker">From the Substack</span>
      <ul class="essay-list">
        {substackPosts.slice(0, 5).map((p) => (
          <li><a href={p.link}>{p.title}</a></li>
        ))}
      </ul>
    </section>
  )}
</Base>

<style>
  .dek { font-style: italic; font-size: 19px; color: var(--muted); }
  .essay-list { list-style: none; padding: 0; margin: 0; }
  .essay-list li { padding: 1rem 0; border-bottom: 1px solid var(--hairline); }
  .essay-list a { font-family: var(--font-display); font-size: 24px; font-weight: 500; }
  .date { font-family: var(--font-mono); font-size: 12px; color: var(--faint); letter-spacing: .05em; }
  .format-badge {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--accent);
    margin-right: 0.5rem;
  }
</style>
