---
// Base shell — Just Asking Questions brand kit (percontation mark, EB Garamond/Newsreader/IBM Plex Mono).
import '../styles/fonts.css';
import '../styles/tokens.css';
import { serializeJsonLd } from '@pub/core';
import { siteConfig } from '../site.config.js';

const {
  title = siteConfig.name,
  description = '',
  ogImage = siteConfig.defaultOgImage,
  type = 'website',
  publishedTime = null,
  modifiedTime = null,
  jsonLd = null,
} = Astro.props;
const site = Astro.site || new URL(import.meta.env.PUBLIC_SITE_URL || siteConfig.siteUrl);
const canonical = new URL(Astro.url.pathname, site).toString();
const absoluteOgImage = ogImage ? new URL(ogImage, site).toString() : null;
const rssUrl = new URL('/rss.xml', site).toString();
---
<!doctype html>
<html lang="en" data-theme-storage-key={siteConfig.themeStorageKey}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={`${siteConfig.name} RSS`} href={rssUrl} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={type} />
    {absoluteOgImage && <meta property="og:image" content={absoluteOgImage} />}
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    <meta name="twitter:card" content="summary_large_image" />
    {absoluteOgImage && <meta name="twitter:image" content={absoluteOgImage} />}
    {jsonLd && <script type="application/ld+json" set:html={serializeJsonLd(jsonLd)} />}
    <link rel="icon" href={siteConfig.favicon} type="image/svg+xml" />
    <script is:inline src="/theme-init.js"></script>
    {import.meta.env.PROD && <script is:inline defer src="/_vercel/insights/script.js"></script>}
  </head>
  <body>
    <header class="masthead">
      <a href="/" class="lockup">
        <span class="mark-ring"><span class="mark-glyph">?</span></span>
        <span class="wordmark">{siteConfig.name}</span>
      </a>
      <nav class="nav">
        <a href="/about/">About</a>
        <button id="theme-toggle" class="theme-toggle" aria-label="Toggle theme" aria-pressed="false" type="button">☾</button>
        <a class="subscribe-btn" href={siteConfig.subscribeUrl} target="_blank" rel="noopener">Subscribe</a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="colophon">
      <span class="mark-bare">?</span>
      <p class="byline">{siteConfig.byline}</p>
      <p class="copyright">&copy; {new Date().getFullYear()} · <a href={siteConfig.substackUrl}>Subscribe on Substack</a></p>
    </footer>

    <script is:inline src="/theme-toggle.js"></script>
  </body>
</html>

<style is:global>
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--background);
    color: var(--ink);
    font-family: var(--font-body);
    font-size: 19px;
    line-height: 1.75;
    transition: background .2s, color .2s;
  }
  main { max-width: var(--measure); margin: 0 auto; padding: 3rem 1.5rem 5rem; }
  a { color: var(--ink); text-decoration: none; border-bottom: 1px solid transparent; }
  a:hover { color: var(--accent); border-bottom-color: rgba(122,46,42,.4); }
  ::selection { background: var(--accent); color: var(--background); }

  h1, h2, h3 { font-family: var(--font-display); font-weight: 500; color: var(--ink); line-height: 1.1; }
  h1 { font-size: clamp(44px, 6vw, 64px); line-height: 1.08; }
  h2 { font-size: 30px; }
  h3 { font-size: 22px; }
  img { max-width: 100%; height: auto; }

  blockquote {
    margin: 1.75rem 0; padding-left: 24px;
    border-left: 2px solid var(--accent);
    font-family: var(--font-display); font-weight: 500; font-style: italic;
    font-size: 24px; line-height: 1.42; color: var(--ink);
  }
  hr { border: 0; text-align: center; margin: 3rem auto; }
  hr::after {
    content: '?'; display: inline-block; transform: scaleX(-1);
    font-family: var(--font-display); font-weight: 500; font-size: 24px; color: var(--accent);
  }
  pre { background: var(--panel); border: 1px solid var(--hairline-strong); padding: 1rem; overflow-x: auto; font-family: var(--font-mono); font-size: 14px; }
  code { font-family: var(--font-mono); }

  .kicker {
    font-family: var(--font-mono); text-transform: uppercase; letter-spacing: .2em;
    font-size: 11px; color: var(--faint); display: block; margin-bottom: .6rem;
  }

  .masthead {
    display: flex; align-items: center; justify-content: space-between;
    padding: 1.25rem 1.5rem; border-bottom: 1px solid var(--hairline);
  }
  .lockup { display: flex; align-items: center; gap: 14px; color: var(--ink); border-bottom: none !important; }
  .mark-ring {
    width: 44px; height: 44px; border-radius: 50%; border: 1.5px solid var(--ink);
    display: flex; align-items: center; justify-content: center; flex-shrink: 0;
  }
  .mark-glyph { display: inline-block; transform: scaleX(-1); font-family: var(--font-display); font-weight: 500; color: var(--accent); font-size: 22px; }
  .wordmark { font-family: var(--font-display); font-weight: 500; font-size: 22px; }
  .nav { display: flex; align-items: center; gap: 1.25rem; font-family: var(--font-mono); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; }
  .nav a { color: var(--ink); border-bottom: none; }
  .theme-toggle {
    font-family: var(--font-mono); border: 1px solid var(--hairline-strong); background: transparent;
    color: var(--ink); width: 30px; height: 30px; cursor: pointer; border-radius: 0;
  }
  .subscribe-btn {
    font-family: var(--font-mono); font-size: 11px; letter-spacing: .14em; text-transform: uppercase;
    background: var(--accent); color: var(--background) !important; padding: 8px 16px;
    border: 1px solid var(--accent); border-bottom: none !important;
  }
  .subscribe-btn:hover { background: transparent; color: var(--accent) !important; }

  .colophon { padding: 3rem 1.5rem 4rem; text-align: center; }
  .mark-bare { display: inline-block; transform: scaleX(-1); font-family: var(--font-display); font-weight: 500; color: var(--accent); font-size: 32px; }
  .byline { font-family: var(--font-mono); font-size: 11px; letter-spacing: .14em; color: var(--muted); margin-top: .5rem; }
  .copyright { font-family: var(--font-mono); font-size: 11px; color: var(--faint); }
</style>
