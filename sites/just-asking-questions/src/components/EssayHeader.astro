---
import { FORMAT_LABELS } from '@pub/site-kit';
import { siteConfig } from '../site.config.js';

const { title, description, date, format = 'essay', author = siteConfig.author } = Astro.props;
const label = FORMAT_LABELS[format] || 'Essay';
const dateLabel = date instanceof Date
  ? date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })
  : date;
---
<span class="kicker">{label}</span>
<h1>{title}</h1>
{description && <p class="dek">{description}</p>}
<p class="byline">{author} · {dateLabel}</p>

<style>
  .dek { font-style: italic; font-size: 19px; color: var(--muted); }
  .byline { font-family: var(--font-mono); font-size: 11px; letter-spacing: .16em; text-transform: uppercase; color: var(--faint); margin-top: 1rem; }
</style>
